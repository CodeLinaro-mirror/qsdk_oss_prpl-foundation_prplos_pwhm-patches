+ * @param mloLinkId network interface MLO Link ID, otherwise MLO_LINK_ID_UNKNOWN for non-MLD
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+swl_rc_ne wld_nl80211_setMloLinkTxPowerAuto(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId);
+
 /*
  * @brief configure fixed transmit power level
  * (Synchronous api)
@@ -467,6 +480,20 @@ swl_rc_ne wld_nl80211_setTxPowerAuto(wld_nl80211_state_t* state, uint32_t ifInde
  */
