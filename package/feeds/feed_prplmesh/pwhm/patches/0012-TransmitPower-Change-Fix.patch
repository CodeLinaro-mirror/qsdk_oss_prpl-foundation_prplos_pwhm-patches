 }
 
 swl_rc_ne wld_rad_nl80211_setTxPowerAuto(T_Radio* pRadio) {
-    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "NULL");
-    return wld_nl80211_setTxPowerAuto(wld_nl80211_getSharedState(), pRadio->index);
+    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "No radio ctx");
+    int8_t mloLinkId = MLO_LINK_ID_UNKNOWN;
+    int32_t index = 0;
+    swl_rc_ne rc = wld_rad_nl80211_getFirstActiveIntfLinkInfo(pRadio, &index, &mloLinkId);
+    ASSERT_FALSE(rc < SWL_RC_OK, SWL_RC_ERROR, ME, "failed to get radio's first active interface");
+    SAH_TRACEZ_INFO(ME, "%s: Set TxPwr auto index(%d), LinkID (%d)", pRadio->Name, index, mloLinkId);
+    return wld_nl80211_setMloLinkTxPowerAuto(wld_nl80211_getSharedState(), index, mloLinkId);
 }
 
 swl_rc_ne wld_rad_nl80211_setTxPowerFixed(T_Radio* pRadio, int32_t dbm) {
-    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "NULL");
-    return wld_nl80211_setTxPowerFixed(wld_nl80211_getSharedState(), pRadio->index, dbm);
+    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "No radio ctx");
+    int8_t mloLinkId = MLO_LINK_ID_UNKNOWN;
+    int32_t index = 0;
+    swl_rc_ne rc = wld_rad_nl80211_getFirstActiveIntfLinkInfo(pRadio, &index, &mloLinkId);
+    ASSERT_FALSE(rc < SWL_RC_OK, SWL_RC_ERROR, ME, "failed to get radio's first active interface");
+    SAH_TRACEZ_INFO(ME, "%s: Set TxPwr fixed index(%d), LinkID (%d)", pRadio->Name, index, mloLinkId);
+    return wld_nl80211_setMloLinkTxPowerFixed(wld_nl80211_getSharedState(), index, mloLinkId, dbm);
 }
 
 swl_rc_ne wld_rad_nl80211_setTxPowerLimited(T_Radio* pRadio, int32_t dbm) {
-    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "NULL");
-    return wld_nl80211_setTxPowerLimited(wld_nl80211_getSharedState(), pRadio->index, dbm);
+    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "No radio ctx");
+    int8_t mloLinkId = MLO_LINK_ID_UNKNOWN;
+    int32_t index = 0;
+    swl_rc_ne rc = wld_rad_nl80211_getFirstActiveIntfLinkInfo(pRadio, &index, &mloLinkId);
+    ASSERT_FALSE(rc < SWL_RC_OK, SWL_RC_ERROR, ME, "failed to get radio's first active interface");
+    SAH_TRACEZ_INFO(ME, "%s: Set TxPwr limited index(%d), LinkID (%d)", pRadio->Name, index, mloLinkId);
+    return wld_nl80211_setMloLinkTxPowerLimited(wld_nl80211_getSharedState(), index, mloLinkId, dbm);
 }
 
 swl_rc_ne wld_rad_nl80211_getTxPower(T_Radio* pRadio, int32_t* dbm) {
-    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "NULL");
-    uint32_t ifIndex = wld_rad_getFirstEnabledIfaceIndex(pRadio);
-    if(ifIndex <= 0) {
-        SAH_TRACEZ_ERROR(ME, "%s: rad has no enabled iface", pRadio->Name);
-        return SWL_RC_ERROR;
-    }
-    return wld_nl80211_getTxPower(wld_nl80211_getSharedState(), ifIndex, dbm);
+    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "No radio ctx");
+    int8_t mloLinkId = MLO_LINK_ID_UNKNOWN;
+    int32_t index = 0;
+    swl_rc_ne rc = wld_rad_nl80211_getFirstActiveIntfLinkInfo(pRadio, &index, &mloLinkId);
+    ASSERT_FALSE(rc < SWL_RC_OK, SWL_RC_ERROR, ME, "failed to get radio's first active interface");
+    SAH_TRACEZ_INFO(ME, "%s: Get TxPwr index(%d), LinkID (%d)", pRadio->Name, index, mloLinkId);
+    return wld_nl80211_getMloLinkTxPower(wld_nl80211_getSharedState(), index, mloLinkId, dbm);
 }
 
 swl_rc_ne wld_rad_nl80211_getMaxTxPowerdBm(T_Radio* pRad, uint16_t channel, int32_t* dbm) {
@@ -719,6 +734,35 @@ swl_rc_ne wld_rad_nl80211_getFirstEnabledVapLinkInfo(T_Radio* pRadio, int32_t* p
     return SWL_RC_OK;
 }
 
+swl_rc_ne wld_rad_nl80211_getFirstActiveIntfLinkInfo(T_Radio* pRadio, int32_t* pIfIndex, int8_t* pLinkId) {
+    int8_t ifMloLinkId = MLO_LINK_ID_UNKNOWN;
+    int32_t index = 0;
+    W_SWL_SETPTR(pIfIndex, index);
+    W_SWL_SETPTR(pLinkId, ifMloLinkId);
+    ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "No radio ctx");
+    T_SSID* pSSID = NULL;
+    T_AccessPoint* pAP = wld_rad_getFirstActiveAp(pRadio);
+    if((pAP != NULL) && (pAP->pSSID != NULL)) {
+        pSSID = pAP->pSSID;
+    } else {
+        T_EndPoint* pEP = wld_rad_getFirstActiveEp(pRadio);
+        if((pEP != NULL) && (pEP->pSSID != NULL)) {
+            pSSID = pEP->pSSID;
+        }
+    }
+
+    if(pSSID != NULL) {
+        index = wld_ssid_nl80211_getPrimaryLinkIfIndex(pSSID);
+        ifMloLinkId = wld_ssid_nl80211_getMldLinkId(pSSID);
+
+        W_SWL_SETPTR(pIfIndex, index);
+        W_SWL_SETPTR(pLinkId, ifMloLinkId);
+        return SWL_RC_OK;
+    }
+
+    return SWL_RC_NOT_AVAILABLE;
+}
+
 swl_rc_ne wld_rad_nl80211_bgDfsStart(T_Radio* pRadio, wld_startBgdfsArgs_t* args) {
     ASSERT_NOT_NULL(pRadio, SWL_RC_INVALID_PARAM, ME, "NULL");
     ASSERT_NOT_NULL(args, SWL_RC_INVALID_PARAM, ME, "NULL");
