+
 /*
  * @brief get maximum transmit power level
  * (Synchronous api)
diff --git a/include/wld/wld_rad_nl80211.h b/include/wld/wld_rad_nl80211.h
index 5ab058319..6c3cd6d91 100644
--- a/include/wld/wld_rad_nl80211.h
+++ b/include/wld/wld_rad_nl80211.h
@@ -534,4 +534,16 @@ swl_rc_ne wld_rad_nl80211_registerFrame(T_Radio* pRadio, uint16_t type, const ch
  */
 swl_rc_ne wld_rad_nl80211_getFirstEnabledVapLinkInfo(T_Radio* pRadio, int32_t* pIfIndex, int8_t* pLinkId);
 
+/*
+ * @brief get first active radio's interface mld link info (mld iface index, and mld link id)
+ *
+ * @param pRadio pointer to radio context
+ * @param pIfIndex pointer to mld iface index to be filled
+ * @param pLinkId pointer to mld link id to be filled
+ *
+ * @return SWL_RC_OK in case of success
+ *         <= SWL_RC_ERROR otherwise
+ */
+swl_rc_ne wld_rad_nl80211_getFirstActiveIntfLinkInfo(T_Radio* pRadio, int32_t* pIfIndex, int8_t* pLinkId);
+
 #endif /* INCLUDE_WLD_WLD_RAD_NL80211_H_ */
diff --git a/src/nl80211/wld_nl80211_api.c b/src/nl80211/wld_nl80211_api.c
index a0c4249be..72289953c 100644
--- a/src/nl80211/wld_nl80211_api.c
+++ b/src/nl80211/wld_nl80211_api.c
@@ -802,8 +802,12 @@ swl_rc_ne wld_nl80211_setWiphyAntennas(wld_nl80211_state_t* state, uint32_t ifIn
     return rc;
 }
 
-static swl_rc_ne s_setTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, enum nl80211_tx_power_setting type, int32_t dbm) {
+static swl_rc_ne s_setTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId, enum nl80211_tx_power_setting type, int32_t dbm) {
     NL_ATTRS(attribs, ARR(NL_ATTR_VAL(NL80211_ATTR_WIPHY_TX_POWER_SETTING, type)));
+
+    if((mloLinkId != MLO_LINK_ID_UNKNOWN) && (mloLinkId >= 0)) {
+        NL_ATTRS_ADD(&attribs, NL_ATTR_VAL(NL80211_ATTR_MLO_LINK_ID, mloLinkId));
+    }
     if(type != NL80211_TX_POWER_AUTOMATIC) {
         dbm *= 100;
         NL_ATTRS_ADD(&attribs, NL_ATTR_VAL(NL80211_ATTR_WIPHY_TX_POWER_LEVEL, dbm));
@@ -813,27 +817,50 @@ static swl_rc_ne s_setTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, enum
     return rc;
 }
 
+swl_rc_ne wld_nl80211_setMloLinkTxPowerAuto(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId) {
+    return s_setTxPower(state, ifIndex, mloLinkId, NL80211_TX_POWER_AUTOMATIC, 0);
+}
+
 swl_rc_ne wld_nl80211_setTxPowerAuto(wld_nl80211_state_t* state, uint32_t ifIndex) {
-    return s_setTxPower(state, ifIndex, NL80211_TX_POWER_AUTOMATIC, 0);
+    int8_t mloLinkId = -1;
+    return wld_nl80211_setMloLinkTxPowerAuto(state, ifIndex, mloLinkId);
+}
+
+swl_rc_ne wld_nl80211_setMloLinkTxPowerFixed(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId, int32_t dbm) {
+    return s_setTxPower(state, ifIndex, mloLinkId, NL80211_TX_POWER_FIXED, dbm);
 }
 
 swl_rc_ne wld_nl80211_setTxPowerFixed(wld_nl80211_state_t* state, uint32_t ifIndex, int32_t dbm) {
-    return s_setTxPower(state, ifIndex, NL80211_TX_POWER_FIXED, dbm);
+    int8_t mloLinkId = -1;
+    return wld_nl80211_setMloLinkTxPowerFixed(state, ifIndex, mloLinkId, dbm);
+}
+
+swl_rc_ne wld_nl80211_setMloLinkTxPowerLimited(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId, int32_t dbm) {
+    return s_setTxPower(state, ifIndex, mloLinkId, NL80211_TX_POWER_LIMITED, dbm);
 }
 
 swl_rc_ne wld_nl80211_setTxPowerLimited(wld_nl80211_state_t* state, uint32_t ifIndex, int32_t dbm) {
-    return s_setTxPower(state, ifIndex, NL80211_TX_POWER_LIMITED, dbm);
+    int8_t mloLinkId = -1;
+    return wld_nl80211_setMloLinkTxPowerLimited(state, ifIndex, mloLinkId, dbm);
 }
 
-swl_rc_ne wld_nl80211_getTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, int32_t* dbm) {
+swl_rc_ne wld_nl80211_getMloLinkTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, int8_t mloLinkId, int32_t* dbm) {
     wld_nl80211_ifaceInfo_t ifaceInfo;
     swl_rc_ne rc = wld_nl80211_getInterfaceInfo(state, ifIndex, &ifaceInfo);
     ASSERT_FALSE(rc < SWL_RC_OK, rc, ME, "fail to get radio main iface info");
-    //return iface txpower or primary link txpower
-    *dbm = ((!ifaceInfo.txPower) && (ifaceInfo.nMloLinks > 0)) ? ifaceInfo.mloLinks[0].txPower : ifaceInfo.txPower;
+    if((mloLinkId != MLO_LINK_ID_UNKNOWN) && (mloLinkId >= 0) && (ifaceInfo.nMloLinks > (uint8_t) mloLinkId)) {
+        *dbm = ifaceInfo.mloLinks[mloLinkId].txPower;
+    } else {
+        *dbm = ifaceInfo.txPower;
+    }
     return rc;
 }
 
+swl_rc_ne wld_nl80211_getTxPower(wld_nl80211_state_t* state, uint32_t ifIndex, int32_t* dbm) {
+    int8_t mloLinkId = -1;
+    return wld_nl80211_getMloLinkTxPower(state, ifIndex, mloLinkId, dbm);
+}
+
 swl_rc_ne wld_nl80211_getMaxTxPowerdBm(wld_nl80211_state_t* state, uint32_t ifIndex, uint32_t freq, int32_t* dbm) {
     int32_t locDbm = 0;
     ASSERT_TRUE(freq > 0, SWL_RC_INVALID_PARAM, ME, "invalid freq");
diff --git a/src/nl80211/wld_rad_nl80211.c b/src/nl80211/wld_rad_nl80211.c
index 217753c39..fc385e832 100644
