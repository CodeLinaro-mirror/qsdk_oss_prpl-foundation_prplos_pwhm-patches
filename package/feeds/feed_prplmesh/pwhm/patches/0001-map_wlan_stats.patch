diff --git a/src/Utils/wld_linuxIfStats.c b/src/Utils/wld_linuxIfStats.c
index 3d1b822..8b61aa7 100644
--- a/src/Utils/wld_linuxIfStats.c
+++ b/src/Utils/wld_linuxIfStats.c
@@ -75,6 +75,20 @@
 #include <linux/netlink.h>
 #include <linux/rtnetlink.h>

+/*
+ * WiFi Telemetry via NL80211 vendor command.
+ */
+#include <netlink/netlink.h>
+#include <linux/nl80211.h>
+#include <netlink/attr.h>
+#include <netlink/msg.h>
+#include <net/if.h>
+
+/* pwhm nl80211 framework */
+#include "wld_nl80211_api.h"
+#include "wld_nl80211_attr.h"
+#include "wld_nl80211_events.h"
+
 #define ME "linuxIfStats"


@@ -84,6 +98,76 @@

 #define IFLIST_REPLY_BUFFER 8192

+/* QCA vendor ID */
+#define QCA_NL80211_VENDOR_ID               0x001374
+
+/* QCA vendor subcmd for WDEV telemetry (VAP/STA level) */
+#define QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL  263
+
+/*
+ * The driver sends the telemetry event with the SAME subcmd value as the
+ * command (263).
+ */
+#define QCA_NL80211_VENDOR_SUBCMD_WLAN_WDEV_TELEMETRY_EVENT_VAL  \
+    QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL   /* = 263 */
+
+/* Stats object: VAP = 1 */
+#define TELEMETRY_STATS_OBJ_VAP             1
+
+/* QCA_VENDOR_ATTR_WLAN_TELEMETRY_* (request attributes) */
+#define TELE_ATTR_OBJECT                    1   /* QCA_VENDOR_ATTR_WLAN_TELEMETRY_OBJECT    (u8)  */
+#define TELE_ATTR_FEATURE                   2   /* QCA_VENDOR_ATTR_WLAN_TELEMETRY_FEATURE   (nested flags) */
+#define TELE_ATTR_REQUEST_ID                4   /* QCA_VENDOR_ATTR_WLAN_TELEMETRY_REQUEST_ID (u64) */
+
+/* Feature flag attributes */
+#define TELE_FEAT_TX                        1   /* QCA_VENDOR_ATTR_WLAN_FEAT_TX (flag) */
+#define TELE_FEAT_RX                        2   /* QCA_VENDOR_ATTR_WLAN_FEAT_RX (flag) */
+
+/* Reply event attributes */
+#define TELE_EVT_ATTR_OBJECT                1
+#define TELE_EVT_ATTR_LINK_ID               2
+#define TELE_EVT_ATTR_REQUEST_ID            3
+#define TELE_EVT_ATTR_TX_STATS              4
+#define TELE_EVT_ATTR_RX_STATS              5
+#define TELE_EVT_ATTR_MAX                   8
+
+/* TX stats event nested attributes */
+#define TELE_TX_STATS_PER_PKT               2
+#define TELE_TX_STATS_MAX                   3
+
+/* RX stats event nested attributes */
+#define TELE_RX_STATS_PER_PKT               5
+#define TELE_RX_STATS_MAX                   5
+
+/* TCL/REO ring attributes */
+#define TELE_TCL_RING_MAX                   4
+#define TELE_REO_RING_MAX                   4
+
+/* Per-packet TX stats attributes (enum qca_vendor_wlan_telemetry_stats_tx) */
+#define TELE_TX_PKT_FAILED                  3   /* QCA_VENDOR_ATTR_PER_PKT_STATS_TX_FAILED          (u32)    */
+#define TELE_TX_PKT_MCAST                   14  /* QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_MCAST   (nested) */
+#define TELE_TX_PKT_UCAST                   15  /* QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_UCAST   (nested) */
+#define TELE_TX_PKT_BCAST                   16  /* QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_BCAST   (nested) */
+#define TELE_TX_PKT_MAX                     16
+
+/* Per-packet RX stats attributes (enum qca_vendor_wlan_telemetry_per_pkt_stats_rx_attr) */
+#define TELE_RX_PKT_MCAST                   4   /* QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_MCAST   (nested) */
+#define TELE_RX_PKT_UCAST                   5   /* QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_UCAST   (nested) */
+#define TELE_RX_PKT_BCAST                   6   /* QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_BCAST   (nested) */
+#define TELE_RX_PKT_FAILED                  7   /* QCA_VENDOR_ATTR_PER_PKT_STATS_RX_FAILED          (u32)    */
+#define TELE_RX_PKT_MAX                     10
+
+/* Packet info attributes */
+#define TELE_PKTINFO_PKTS                   1   /* QCA_VENDOR_WLAN_TELEMETRY_ATTR_PKTINFO_PKTS  (u32) */
+#define TELE_PKTINFO_BYTES                  2   /* QCA_VENDOR_WLAN_TELEMETRY_ATTR_PKTINFO_BYTES (u64) */
+#define TELE_PKTINFO_MAX                    2
+
+/*
+ * Request ID: simple monotonic counter.
+ * Used to match the async vendor event reply to the specific request.
+ */
+#define TELE_REQ_ID_MASK                    0xFFFFFFFF
+

 /**
  * PRIVATE STURCTURS
@@ -95,6 +179,439 @@ typedef struct {
     struct rtgenmsg gen; // General form of address family dependent message
 } nl_req_t;

+/**
+ * @brief Holds the WiFi telemetry packet stats parsed from the vendor event.
+ *
+ * All packet/byte counts are summed across all hardware rings.
+ */
+typedef struct {
+    /* RX stats */
+    uint32_t rxFailed;          /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_FAILED            */
+    uint32_t mcastRxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_MCAST pkts */
+    uint64_t mcastRxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_MCAST bytes */
+    uint32_t ucastRxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_UCAST pkts */
+    uint64_t ucastRxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_UCAST bytes */
+    uint32_t bcastRxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_BCAST pkts */
+    uint64_t bcastRxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_BCAST bytes */
+    /* TX stats */
+    uint32_t txFailed;          /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_FAILED            */
+    uint32_t mcastTxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_MCAST pkts */
+    uint64_t mcastTxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_MCAST bytes */
+    uint32_t ucastTxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_UCAST pkts */
+    uint64_t ucastTxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_UCAST bytes */
+    uint32_t bcastTxPackets;    /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_BCAST pkts */
+    uint64_t bcastTxBytes;      /**< QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_BCAST bytes */
+    /* Control */
+    bool     received;          /**< Set to true when a matching vendor event is received */
+    uint64_t requestId;         /**< Request ID echoed by driver; used to match the reply */
+} s_wifiTelemetryPktStats_t;
+
+
+/**
+ * PRIVATE FUNCTIONS - WiFi Telemetry stat parsers
+ */
+
+/**
+ * @brief Parse a nested pkt_info attribute and accumulate packets/bytes.
+ */
+static void s_teleParsePktInfo(struct nlattr* tb, uint32_t* packets, uint64_t* bytes) {
+    struct nlattr* pktAttr[TELE_PKTINFO_MAX + 1];
+    memset(pktAttr, 0, sizeof(pktAttr));
+
+    if(nla_parse_nested(pktAttr, TELE_PKTINFO_MAX, tb, NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse pkt_info nested attr");
+        return;
+    }
+
+    if(pktAttr[TELE_PKTINFO_PKTS])
+        *packets += nla_get_u32(pktAttr[TELE_PKTINFO_PKTS]);
+
+    if(pktAttr[TELE_PKTINFO_BYTES])
+        *bytes += nla_get_u64(pktAttr[TELE_PKTINFO_BYTES]);
+}
+
+/**
+ * @brief Parse TX stats nested attribute from the vendor event.
+ *
+ * Iterates over all TCL rings and accumulates TX_FAILED, TX_MCAST, TX_UCAST, TX_BCAST.
+ */
+static void s_teleParseTxStats(struct nlattr* txStatsTb, s_wifiTelemetryPktStats_t* pStats) {
+    struct nlattr* txStats[TELE_TX_STATS_MAX + 1];
+    struct nlattr* tclRing[TELE_TCL_RING_MAX + 1];
+    int ring = 0;
+
+    memset(txStats, 0, sizeof(txStats));
+    memset(tclRing, 0, sizeof(tclRing));
+
+    if(nla_parse_nested(txStats, TELE_TX_STATS_MAX, txStatsTb, NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse TX stats nested attr");
+        return;
+    }
+
+    if(!txStats[TELE_TX_STATS_PER_PKT])
+        return;
+
+    if(nla_parse_nested(tclRing, TELE_TCL_RING_MAX,
+                        txStats[TELE_TX_STATS_PER_PKT], NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse TCL ring nested attr");
+        return;
+    }
+
+    for(ring = 0; ring < TELE_TCL_RING_MAX; ring++) {
+        if(!tclRing[ring + 1])
+            continue;
+
+        struct nlattr* txPkt[TELE_TX_PKT_MAX + 1];
+        memset(txPkt, 0, sizeof(txPkt));
+
+        if(nla_parse_nested(txPkt, TELE_TX_PKT_MAX, tclRing[ring + 1], NULL) != 0)
+            continue;
+
+        if(txPkt[TELE_TX_PKT_FAILED])
+            pStats->txFailed += nla_get_u32(txPkt[TELE_TX_PKT_FAILED]);
+
+        if(txPkt[TELE_TX_PKT_MCAST])
+            s_teleParsePktInfo(txPkt[TELE_TX_PKT_MCAST],
+                               &pStats->mcastTxPackets, &pStats->mcastTxBytes);
+
+        if(txPkt[TELE_TX_PKT_UCAST])
+            s_teleParsePktInfo(txPkt[TELE_TX_PKT_UCAST],
+                               &pStats->ucastTxPackets, &pStats->ucastTxBytes);
+
+        if(txPkt[TELE_TX_PKT_BCAST])
+            s_teleParsePktInfo(txPkt[TELE_TX_PKT_BCAST],
+                               &pStats->bcastTxPackets, &pStats->bcastTxBytes);
+    }
+}
+
+/**
+ * @brief Parse RX stats nested attribute from the vendor event.
+ *
+ * Iterates over all REO rings and accumulates RX_FAILED, RX_MCAST, RX_UCAST, RX_BCAST.
+ */
+static void s_teleParseRxStats(struct nlattr* rxStatsTb, s_wifiTelemetryPktStats_t* pStats) {
+    struct nlattr* rxStats[TELE_RX_STATS_MAX + 1];
+    struct nlattr* reoRing[TELE_REO_RING_MAX + 1];
+    int ring = 0;
+
+    memset(rxStats, 0, sizeof(rxStats));
+    memset(reoRing, 0, sizeof(reoRing));
+
+    if(nla_parse_nested(rxStats, TELE_RX_STATS_MAX, rxStatsTb, NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse RX stats nested attr");
+        return;
+    }
+
+    if(!rxStats[TELE_RX_STATS_PER_PKT])
+        return;
+
+    if(nla_parse_nested(reoRing, TELE_REO_RING_MAX,
+                        rxStats[TELE_RX_STATS_PER_PKT], NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse REO ring nested attr");
+        return;
+    }
+
+    for(ring = 0; ring < TELE_REO_RING_MAX; ring++) {
+        if(!reoRing[ring + 1])
+            continue;
+
+        struct nlattr* rxPkt[TELE_RX_PKT_MAX + 1];
+        memset(rxPkt, 0, sizeof(rxPkt));
+
+        if(nla_parse_nested(rxPkt, TELE_RX_PKT_MAX, reoRing[ring + 1], NULL) != 0)
+            continue;
+
+        if(rxPkt[TELE_RX_PKT_FAILED])
+            pStats->rxFailed += nla_get_u32(rxPkt[TELE_RX_PKT_FAILED]);
+
+        if(rxPkt[TELE_RX_PKT_MCAST])
+            s_teleParsePktInfo(rxPkt[TELE_RX_PKT_MCAST],
+                               &pStats->mcastRxPackets, &pStats->mcastRxBytes);
+
+        if(rxPkt[TELE_RX_PKT_UCAST])
+            s_teleParsePktInfo(rxPkt[TELE_RX_PKT_UCAST],
+                               &pStats->ucastRxPackets, &pStats->ucastRxBytes);
+
+        if(rxPkt[TELE_RX_PKT_BCAST])
+            s_teleParsePktInfo(rxPkt[TELE_RX_PKT_BCAST],
+                               &pStats->bcastRxPackets, &pStats->bcastRxBytes);
+    }
+}
+
+
+/**
+ * PRIVATE FUNCTIONS - pwhm nl80211 callbacks
+ */
+
+/**
+ * @brief Vendor event callback registered via wld_nl80211_addVendorEvtListener().
+ *
+ * @param pRef   Unused (NULL).
+ * @param pData  Pointer to s_wifiTelemetryPktStats_t (passed as pData to addEvtListener).
+ * @param nlh    Netlink message header of the vendor event.
+ * @param tb     Pre-parsed NL80211_ATTR_* attribute table.
+ */
+static void s_teleVendorEvtCb(void* pRef, void* pData,
+                               struct nlmsghdr* nlh, struct nlattr* tb[]) {
+    (void)pRef;
+    s_wifiTelemetryPktStats_t* pStats = (s_wifiTelemetryPktStats_t*)pData;
+
+    if(!pStats || pStats->received)
+        return;
+
+    /* Filter: QCA vendor ID */
+    if(!tb[NL80211_ATTR_VENDOR_ID] || !tb[NL80211_ATTR_VENDOR_SUBCMD])
+        return;
+    if(nla_get_u32(tb[NL80211_ATTR_VENDOR_ID]) != QCA_NL80211_VENDOR_ID)
+        return;
+
+    /* Filter: WDEV telemetry event subcmd (= 263, same as command subcmd) */
+    if(nla_get_u32(tb[NL80211_ATTR_VENDOR_SUBCMD]) !=
+       QCA_NL80211_VENDOR_SUBCMD_WLAN_WDEV_TELEMETRY_EVENT_VAL)
+        return;
+
+    /*
+     * Use wld_nl80211_getVendorDataFromVendorMsg() to extract the
+     * data from the event message.
+     */
+    void*  vendorData    = NULL;
+    size_t vendorDataLen = 0;
+    swl_rc_ne rc = wld_nl80211_getVendorDataFromVendorMsg(SWL_RC_OK, nlh,
+                                                          &vendorData, &vendorDataLen);
+    if((rc < SWL_RC_OK) || (vendorData == NULL)) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to extract vendor data from event");
+        return;
+    }
+
+    /* Parse the event-level attribute table */
+    struct nlattr* evtTb[TELE_EVT_ATTR_MAX + 1];
+    memset(evtTb, 0, sizeof(evtTb));
+    if(nla_parse(evtTb, TELE_EVT_ATTR_MAX,
+                 (struct nlattr*)vendorData, (int)vendorDataLen, NULL) != 0) {
+        SAH_TRACEZ_WARNING(ME, "WiFi telemetry: failed to parse event vendor data");
+        return;
+    }
+
+    /* Filter: request ID echoed by driver must match our request */
+    if(evtTb[TELE_EVT_ATTR_REQUEST_ID]) {
+        uint64_t respId = nla_get_u64(evtTb[TELE_EVT_ATTR_REQUEST_ID]);
+        if(respId != pStats->requestId) {
+            SAH_TRACEZ_WARNING(ME,
+                "WiFi telemetry: request ID mismatch (expected 0x%llx, got 0x%llx) - skipping",
+                (unsigned long long)pStats->requestId,
+                (unsigned long long)respId);
+            return;
+        }
+    }
+
+    /* Parse TX stats (per TCL ring) */
+    if(evtTb[TELE_EVT_ATTR_TX_STATS])
+        s_teleParseTxStats(evtTb[TELE_EVT_ATTR_TX_STATS], pStats);
+
+    /* Parse RX stats (per REO ring) */
+    if(evtTb[TELE_EVT_ATTR_RX_STATS])
+        s_teleParseRxStats(evtTb[TELE_EVT_ATTR_RX_STATS], pStats);
+
+    pStats->received = true;
+
+    SAH_TRACEZ_INFO(ME,
+        "WiFi telemetry: vendor event parsed successfully (reqId=0x%llx)",
+        (unsigned long long)pStats->requestId);
+    SAH_TRACEZ_INFO(ME,
+        "  RX: failed=%u  mcast=%u/%llu  ucast=%u/%llu  bcast=%u/%llu",
+        pStats->rxFailed,
+        pStats->mcastRxPackets, (unsigned long long)pStats->mcastRxBytes,
+        pStats->ucastRxPackets, (unsigned long long)pStats->ucastRxBytes,
+        pStats->bcastRxPackets, (unsigned long long)pStats->bcastRxBytes);
+    SAH_TRACEZ_INFO(ME,
+        "  TX: failed=%u  mcast=%u/%llu  ucast=%u/%llu  bcast=%u/%llu",
+        pStats->txFailed,
+        pStats->mcastTxPackets, (unsigned long long)pStats->mcastTxBytes,
+        pStats->ucastTxPackets, (unsigned long long)pStats->ucastTxBytes,
+        pStats->bcastTxPackets, (unsigned long long)pStats->bcastTxBytes);
+}
+
+
+static swl_rc_ne s_teleAckAndWaitHandler(swl_rc_ne rc, struct nlmsghdr* nlh, void* priv) {
+    s_wifiTelemetryPktStats_t* pStats = (s_wifiTelemetryPktStats_t*)priv;
+    if(nlh == NULL) {
+        if(pStats && pStats->received) {
+            SAH_TRACEZ_INFO(ME, "WiFi telemetry: event already received at timeout check");
+            return SWL_RC_DONE;
+        }
+        SAH_TRACEZ_WARNING(ME,
+            "WiFi telemetry: request timed out (REQUEST_SYNC_TIMEOUT) "
+            "without receiving vendor event");
+        return SWL_RC_ERROR;
+    }
+
+    if(rc <= SWL_RC_ERROR) {
+        SAH_TRACEZ_ERROR(ME, "WiFi telemetry: vendor command failed (rc=%d)", rc);
+        return rc;
+    }
+    if(nlh->nlmsg_type == NLMSG_ERROR) {
+        struct nlmsgerr* e = (struct nlmsgerr*)nlmsg_data(nlh);
+        if(e->error == 0) {
+            SAH_TRACEZ_INFO(ME,
+                "WiFi telemetry: ACK received from driver - "
+                "waiting for vendor event (up to REQUEST_SYNC_TIMEOUT s)...");
+            return SWL_RC_CONTINUE;
+        }
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: driver rejected command (err=%d) - "
+            "check interface is up and driver supports subcmd %u",
+            e->error, QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL);
+        return SWL_RC_ERROR;
+    }
+    return SWL_RC_CONTINUE;
+}
+
+/**
+ * @brief Generate a unique 64-bit request ID (PID-shifted counter).
+ */
+static uint64_t s_teleGenerateRequestId(void) {
+    static uint32_t s_counter = 0;
+    s_counter++;
+    return ((uint64_t)getpid() << 32) | ((uint64_t)s_counter & TELE_REQ_ID_MASK);
+}
+
+/**
+ * @brief Send the QCA WiFi telemetry vendor command and receive the async stats event.
+ */
+static bool s_getWifiTelemetryPacketStats(const char* pIfaceName,
+                                          s_wifiTelemetryPktStats_t* pStats) {
+
+    wld_nl80211_state_t* state = wld_nl80211_getSharedState();
+    if(!state) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: no shared nl80211 state - "
+            "pwhm nl80211 not initialised yet");
+        return false;
+    }
+
+
+    uint32_t ifIndex = if_nametoindex(pIfaceName);
+    if(ifIndex == 0) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: interface '%s' not found (if_nametoindex=0)",
+            pIfaceName);
+        return false;
+    }
+
+
+    wld_nl80211_evtHandlers_cb handlers;
+    memset(&handlers, 0, sizeof(handlers));
+
+    wld_nl80211_listener_t* pListener = wld_nl80211_addEvtListener(
+        state,
+        WLD_NL80211_ID_UNDEF,
+        ifIndex,
+        NULL,
+        pStats,
+        &handlers);
+
+    if(!pListener) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: failed to add event listener for '%s'",
+            pIfaceName);
+        return false;
+    }
+
+
+    wld_nl80211_addVendorEvtListener(state, pListener, s_teleVendorEvtCb);
+
+
+    uint8_t  objVal = (uint8_t)TELEMETRY_STATS_OBJ_VAP;
+    uint64_t reqId  = pStats->requestId;
+
+
+    NL_ATTR_NESTED(vendorDataAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorDataAttr.data.attribs, NL_ATTR_VAL(TELE_ATTR_OBJECT, objVal));
+
+    NL_ATTR_NESTED(featAttr, TELE_ATTR_FEATURE);
+    NL_ATTRS_ADD(&featAttr.data.attribs, NL_ATTR(TELE_FEAT_TX));
+    NL_ATTRS_ADD(&featAttr.data.attribs, NL_ATTR(TELE_FEAT_RX));
+    swl_unLiList_add(&vendorDataAttr.data.attribs, &featAttr);
+
+    NL_ATTRS_ADD(&vendorDataAttr.data.attribs, NL_ATTR_VAL(TELE_ATTR_REQUEST_ID, reqId));
+
+
+    SAH_TRACEZ_INFO(ME,
+        "WiFi telemetry: sending NL80211_CMD_VENDOR via pwhm "
+        "[vendorId=0x%04x subcmd=%u ifIndex=%u reqId=0x%llx iface='%s']",
+        QCA_NL80211_VENDOR_ID,
+        QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL,
+        ifIndex,
+        (unsigned long long)reqId,
+        pIfaceName);
+    SAH_TRACEZ_INFO(ME,
+        "WiFi telemetry: vendor data: OBJECT=%u FEATURE=[TX=%u RX=%u]",
+        TELEMETRY_STATS_OBJ_VAP, TELE_FEAT_TX, TELE_FEAT_RX);
+
+    swl_rc_ne rc = wld_nl80211_sendVendorSubCmdAttr(
+        state,
+        QCA_NL80211_VENDOR_ID,
+        QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL,
+        &vendorDataAttr,
+        true,
+        false,
+        0,
+        ifIndex,
+        0,
+        s_teleAckAndWaitHandler,
+        pStats
+    );
+
+
+    if(rc < SWL_RC_OK && !pStats->received) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: wld_nl80211_sendVendorSubCmdAttr failed (rc=%d) "
+            "for iface='%s'", rc, pIfaceName);
+    } else if(rc < SWL_RC_OK && pStats->received) {
+        SAH_TRACEZ_INFO(ME,
