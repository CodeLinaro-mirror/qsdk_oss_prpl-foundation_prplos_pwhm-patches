From d86c7aa417ed8e608f8101ce60ec5ef9bb793ab4 Mon Sep 17 00:00:00 2001
From: Jassim Shanavaskhan <jshanava@qti.qualcomm.com>
Date: Thu, 8 Jan 2026 10:14:54 +0530
Subject: [PATCH] Enable beaconing Boot KPI Marker
Signed-off-by: Jassim Shanavaskhan <jshanava@qti.qualcomm.com>

---
 src/wld_accesspoint.c | 48 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/wld_accesspoint.c b/src/wld_accesspoint.c
index a425fa9..b498a53 100644
--- a/src/wld_accesspoint.c
+++ b/src/wld_accesspoint.c
@@ -95,6 +95,14 @@

 #define ME "ap"

+// Forward declaration
+static void wld_vap_update_beacon_kpi(T_Radio* pRad);
+
+// Static variables for KPI tracking - one per radio band
+static bool kpi_beacon_2g = false;
+static bool kpi_beacon_5g = false;
+static bool kpi_beacon_6g = false;
+
 /* FIX ME. Strings must be const STATIC? */
 const char* cstr_AP_status[] = {"Disabled", "Enabled", "Error_Misconfigured", "Error",
     0};
@@ -2432,6 +2440,11 @@ void wld_vap_updateState(T_AccessPoint* pAP) {

     SAH_TRACEZ_INFO(ME, "%s: ap %u -> %u / ssid %u -> %u", pAP->alias, oldVapStatus, pAP->status, oldSsidStatus, newSsidStatus);

+    // Mark KPI when first VAP on this radio goes UP
+    if(oldSsidStatus != RST_UP && newSsidStatus == RST_UP && pRad != NULL) {
+        wld_vap_update_beacon_kpi(pRad);
+    }
+
     //update DM Status of DM configurable VAPs
     ASSERT_TRUE((pAP->pBus == NULL) ||
                 swl_typeCharPtr_commitObjectParam(pAP->pBus, "Status", (char*) cstr_AP_status[pAP->status]), ,
@@ -2456,6 +2469,41 @@ void wld_vap_updateState(T_AccessPoint* pAP) {
     wld_apRssiMon_updateEnable(pAP);
 }

+static void wld_vap_update_beacon_kpi(T_Radio* pRad) {
+    char cmd[256];
+    bool *kpi_flag = NULL;
+    int radioIndex = -1;
+
+    // Identify radio band based on interface name
+    // wlan2 = 2.4G, wlan1 = 5G, wlan0 = 6G
+    if(strcmp(pRad->Name, "wlan2") == 0) {
+        kpi_flag = &kpi_beacon_2g;
+        radioIndex = 0;
+    } else if(strcmp(pRad->Name, "wlan1") == 0) {
+        kpi_flag = &kpi_beacon_5g;
+        radioIndex = 1;
+    } else if(strcmp(pRad->Name, "wlan0") == 0) {
+        kpi_flag = &kpi_beacon_6g;
+        radioIndex = 2;
+    }
+
+    // Only mark KPI once per radio (when first VAP goes UP)
+    if(kpi_flag != NULL && !(*kpi_flag)) {
+        snprintf(cmd, sizeof(cmd),
+                "echo -n 'M - wifi%d - enable beaconing' >> /sys/kernel/boot_kpi/kpi_values",
+                radioIndex);
+
+        int ret = system(cmd);
+
+        if(ret != 0) {
+            SAH_TRACEZ_ERROR(ME, "Error updating KPI - wifi%d enable beaconing", radioIndex);
+        } else {
+            SAH_TRACEZ_INFO(ME, "Updated KPI - wifi%d enable beaconing", radioIndex);
+            *kpi_flag = true;
+        }
+    }
+}
+
 /**
  * Return whether the AP must be up (true) or down (false) regarding radio state:
  * - Check whether AP is enabled
--
