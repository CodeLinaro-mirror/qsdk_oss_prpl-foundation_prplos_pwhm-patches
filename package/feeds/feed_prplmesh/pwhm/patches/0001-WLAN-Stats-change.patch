+    uint64_t reqId  = pStats->requestId;
+
+
+    NL_ATTR_NESTED(vendorDataAttr, NL80211_ATTR_VENDOR_DATA);
+    NL_ATTRS_ADD(&vendorDataAttr.data.attribs, NL_ATTR_VAL(TELE_ATTR_OBJECT, objVal));
+
+    NL_ATTR_NESTED(featAttr, TELE_ATTR_FEATURE);
+    NL_ATTRS_ADD(&featAttr.data.attribs, NL_ATTR(TELE_FEAT_TX));
+    NL_ATTRS_ADD(&featAttr.data.attribs, NL_ATTR(TELE_FEAT_RX));
+    swl_unLiList_add(&vendorDataAttr.data.attribs, &featAttr);
+
+    NL_ATTRS_ADD(&vendorDataAttr.data.attribs, NL_ATTR_VAL(TELE_ATTR_REQUEST_ID, reqId));
+
+
+    SAH_TRACEZ_INFO(ME,
+        "WiFi telemetry: sending NL80211_CMD_VENDOR via pwhm "
+        "[vendorId=0x%04x subcmd=%u ifIndex=%u reqId=0x%llx iface='%s']",
+        QCA_NL80211_VENDOR_ID,
+        QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL,
+        ifIndex,
+        (unsigned long long)reqId,
+        pIfaceName);
+    SAH_TRACEZ_INFO(ME,
+        "WiFi telemetry: vendor data: OBJECT=%u FEATURE=[TX=%u RX=%u]",
+        TELEMETRY_STATS_OBJ_VAP, TELE_FEAT_TX, TELE_FEAT_RX);
+
+    swl_rc_ne rc = wld_nl80211_sendVendorSubCmdAttr(
+        state,
+        QCA_NL80211_VENDOR_ID,
+        QCA_NL80211_VENDOR_SUBCMD_WLAN_TELEMETRY_WDEV_VAL,
+        &vendorDataAttr,
+        true,
+        false,
+        0,
+        ifIndex,
+        0,
+        s_teleAckAndWaitHandler,
+        pStats,
+        &pStats->received
+    );
+
+
+    /*
+     * Determine success: the vendor event must have been received and its
+     * request ID must have matched (both checked inside s_teleVendorEvtCb).
+     *
+     * We intentionally do NOT gate on (rc >= SWL_RC_OK) here.  The reason is
+     * a framework timing issue: s_teleAckAndWaitHandler can only signal
+     * SWL_RC_DONE when it is called on a *reply* message that carries the
+     * matching sequence number.  After the driver ACK there are no further
+     * reply messages, so the handler is never called again.  The nl80211
+     * sync loop therefore lets the request expire via s_clearExpiredRequests()
+     * which calls s_updateRequest() with rc = SWL_RC_NOT_AVAILABLE.
+     * s_processReply() ignores the handler's SWL_RC_DONE return in that path
+     * (it only propagates the handler result when rc == SWL_RC_OK), so
+     * s_sendMsgSync() ends up returning SWL_RC_NOT_AVAILABLE even though the
+     * vendor event was received successfully before the timeout.
