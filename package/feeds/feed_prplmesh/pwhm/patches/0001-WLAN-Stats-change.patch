+#define TELE_ATTR_FEATURE                   2   /* QCA_VENDOR_ATTR_WLAN_TELEMETRY_FEATURE   (nested flags) */
+#define TELE_ATTR_REQUEST_ID                4   /* QCA_VENDOR_ATTR_WLAN_TELEMETRY_REQUEST_ID (u64) */
