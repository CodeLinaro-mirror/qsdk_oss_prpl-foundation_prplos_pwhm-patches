+    wld_nl80211_state_t* state = wld_nl80211_getSharedState();
+    if(!state) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: no shared nl80211 state - "
+            "pwhm nl80211 not initialised yet");
+        return false;
+    }
+
+
+    uint32_t ifIndex = if_nametoindex(pIfaceName);
+    if(ifIndex == 0) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: interface '%s' not found (if_nametoindex=0)",
+            pIfaceName);
+        return false;
+    }
+
+
+    wld_nl80211_evtHandlers_cb handlers;
+    memset(&handlers, 0, sizeof(handlers));
+
+    wld_nl80211_listener_t* pListener = wld_nl80211_addEvtListener(
+        state,
+        WLD_NL80211_ID_UNDEF,
+        ifIndex,
+        NULL,
+        pStats,
+        &handlers);
+
+    if(!pListener) {
+        SAH_TRACEZ_ERROR(ME,
+            "WiFi telemetry: failed to add event listener for '%s'",
+            pIfaceName);
+        return false;
+    }
+
