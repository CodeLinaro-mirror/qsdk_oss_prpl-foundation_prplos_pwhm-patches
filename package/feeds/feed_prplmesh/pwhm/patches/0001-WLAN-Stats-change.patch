+
+    if(!pStats->received) {
+        SAH_TRACEZ_WARNING(ME,
+            "WiFi telemetry: request timed out for iface='%s' "
+            "(no vendor event received within REQUEST_SYNC_TIMEOUT s)", pIfaceName);
+    } else if(rc < SWL_RC_OK) {
+        SAH_TRACEZ_WARNING(ME,
+            "WiFi telemetry: vendor event received for iface='%s' but nl80211 "
+            "request expired before handler could signal completion (rc=%d) - "
+            "treating as success since data is valid (reqId=0x%llx)",
+            pIfaceName, rc, (unsigned long long)pStats->requestId);
+    }
+
+    wld_nl80211_delEvtListener(&pListener);
+
+    if(success) {
+        SAH_TRACEZ_INFO(ME,
+            "WiFi Telemetry Packet Stats for interface '%s':", pIfaceName);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_RX_FAILED          (ErrorsReceived)          = %u",
+            pStats->rxFailed);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_MCAST   (MulticastPacketsReceived) = %u pkts / %llu bytes",
+            pStats->mcastRxPackets, (unsigned long long)pStats->mcastRxBytes);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_UCAST   (UnicastPacketsReceived)   = %u pkts / %llu bytes",
+            pStats->ucastRxPackets, (unsigned long long)pStats->ucastRxBytes);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_RX_PKTINFO_BCAST   (BroadcastPacketsReceived) = %u pkts / %llu bytes",
+            pStats->bcastRxPackets, (unsigned long long)pStats->bcastRxBytes);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_TX_FAILED          (ErrorsSent)              = %u",
+            pStats->txFailed);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_MCAST   (MulticastPacketsSent)    = %u pkts / %llu bytes",
+            pStats->mcastTxPackets, (unsigned long long)pStats->mcastTxBytes);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_UCAST   (UnicastPacketsSent)      = %u pkts / %llu bytes",
+            pStats->ucastTxPackets, (unsigned long long)pStats->ucastTxBytes);
+        SAH_TRACEZ_INFO(ME,
+            "  QCA_VENDOR_ATTR_PER_PKT_STATS_TX_PKTINFO_BCAST   (BroadcastPacketsSent)    = %u pkts / %llu bytes",
+            pStats->bcastTxPackets, (unsigned long long)pStats->bcastTxBytes);
+    }
+
+    return success;
+}

