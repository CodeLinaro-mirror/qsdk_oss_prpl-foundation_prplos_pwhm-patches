           ARR(uint32_t nl80211ChanStatus; wld_nl80211_chanStatus_e chanStatus; ),
           ARR(swl_type_uint32, swl_type_uint32, ),
@@ -862,6 +894,7 @@ swl_rc_ne s_parseWiphyBands(struct nlattr* tb[], wld_nl80211_wiphyInfo_t* pWiphy
