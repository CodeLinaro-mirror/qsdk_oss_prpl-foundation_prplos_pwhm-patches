+        s_parseUhrAttrs(tbBand, pBand);
         s_parseChans(tbBand, pBand);
         s_parseDataTransmitRates(tbBand, pBand);
     }
diff --git a/src/wld_radio.c b/src/wld_radio.c
index eca46ede1d..c926b9f57f 100644
--- a/src/wld_radio.c
+++ b/src/wld_radio.c
@@ -3710,6 +3710,32 @@ bool wld_rad_hasActiveApMldMultiLink(T_Radio* pRad) {
     return wld_rad_hasActiveApMld(pRad, 2);
 }
 
+bool wld_rad_hasConnectedEpWithRadStd(T_Radio* pRad, swl_radStd_e radStd) {
+    ASSERTS_NOT_NULL(pRad, false, ME, "NULL");
+    T_EndPoint* pEP = NULL;
+    /*
+     * Check if any connected EP with a specific radStd operatingStandard
+     */
+    wld_rad_forEachEp(pEP, pRad) {
+        if(pEP->connectionStatus == EPCS_CONNECTED) {
+            if(pEP->stats.operatingStandard == radStd) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+bool wld_rad_is11bnUsable(T_Radio* pRad) {
+    ASSERTS_NOT_NULL(pRad, false, ME, "NULL");
+    if(wld_rad_hasConnectedEpWithRadStd(pRad, SWL_RADSTD_BN) ||
+       (wld_rad_checkEnabledRadStd(pRad, SWL_RADSTD_BN) &&
+        (!wld_rad_isMloCapable(pRad) || wld_rad_hasUsableApMld(pRad, 1)))) {
+        return true;
+    }
+    return false;
+}
